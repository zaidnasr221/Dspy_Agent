      "required": [
        "profile_id",
        "profile_role",
        "article_type",
        "occurrences",
        "evidence_status"
      ],
      "title": "CatalogueArticle",
      "type": "object"
    },
    "EdgeReference": {
      "additionalProperties": false,
      "properties": {
        "rail_end": {
          "anyOf": [
            {
              "enum": [
                "x0",
                "x1"
