{
  "$defs": {
    "CatalogueArticle": {
      "additionalProperties": false,
      "properties": {
        "profile_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Article ID as printed; null only for a part shown without an ID.",
          "title": "Profile Id"
        },
        "profile_role": {
          "enum": [
            "mullion",
            "transom",
            "pressure_plate",
            "cover_cap",
            "end_cap",
            "isolator",
            "gasket_internal",
            "gasket_external",
            "structural_silicone",
            "weather_seal",
            "toggle",
            "spacer",
            "glass_support",
            "glazing_adaptor",
            "cleat",
            "bracket",
            "sleeve",
            "screw",
            "bolt",
            "rivet",
            "anchor",
            "washer",
            "nut",
            "glass",
            "infill",
            "sealing_tape",
            "other"
          ],
          "title": "Profile Role",
          "type": "string"
        },
        "role_clarification": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Role Clarification"
        },
        "article_type": {
          "anyOf": [
            {
              "enum": [
                "bar",
                "piece",
                "parameter"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Fabrication (FWR) type: bar, piece or parameter.",
          "title": "Article Type"
        },
        "depth": {
          "anyOf": [
            {
              "$ref": "#/$defs/Value"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "edge_spacing": {
          "anyOf": [
            {
              "$ref": "#/$defs/EdgeSpacing"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Pieces only."
        },
        "spacing": {
          "anyOf": [
            {
              "$ref": "#/$defs/Spacing"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Pieces only."
        },
        "quantity": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quantity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "material": {
          "anyOf": [
            {
              "$ref": "#/$defs/Value"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "finish": {
          "anyOf": [
            {
              "$ref": "#/$defs/Value"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "color": {
          "anyOf": [
            {
              "$ref": "#/$defs/Value"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "other": {
          "additionalProperties": {
            "$ref": "#/$defs/Value"
          },
          "description": "All else found.",
          "title": "Other",
          "type": "object"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "systems": {
          "items": {
            "enum": [
              "SG",
              "CC",
              "semi-SG"
            ],
            "type": "string"
          },
          "title": "Systems",
          "type": "array"
        },
        "occurrences": {
          "items": {
            "$ref": "#/$defs/Occurrence"
          },
          "minItems": 1,
          "title": "Occurrences",
          "type": "array"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "title": "Sources",
          "type": "array"
        },
        "conflicts": {
          "items": {
            "type": "string"
          },
          "title": "Conflicts",
          "type": "array"
        },
        "evidence_status": {
          "enum": [
            "explicit",
            "visual",
            "unresolved"
          ],
          "title": "Evidence Status",
          "type": "string"
        },
        "missing_information": {
          "items": {
            "type": "string"
          },
          "title": "Missing Information",
          "type": "array"
        }
