              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Rail End"
        },
        "measured_from": {
          "enum": [
            "rail_end",
            "dimension_line"
          ],
          "title": "Measured From",
          "type": "string"
        },
        "offset": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Offset"
        },
        "offset_unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Offset Unit"
        }
      },
      "required": [
        "rail_end",
        "measured_from"
      ],
      "title": "EdgeReference",
      "type": "object"
    },
    "EdgeSpacing": {
      "additionalProperties": false,
      "description": "End-to-centre distance from a rail end (x0 or x1) to the centre of the nearest article.\nWhen the catalogue measures to a dimension line, the line offset is added or subtracted.",
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "bound": {
          "anyOf": [
            {
              "enum": [
                "exact",
                "minimum",
                "maximum",
                "interval"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bound"
        },
        "condition": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Condition"
        },
        "datum": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Datum"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "title": "Evidence",
          "type": "array"
        },
        "edge_reference": {
          "anyOf": [
            {
              "$ref": "#/$defs/EdgeReference"
            },
            {
              "type": "null"
            }
          ],
          "default": null
