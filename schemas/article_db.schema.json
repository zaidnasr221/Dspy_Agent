        "offset_applied": {
          "anyOf": [
            {
              "enum": [
                "added",
                "subtracted",
                "none"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Offset Applied"
        }
      },
      "required": [
        "value"
      ],
      "title": "EdgeSpacing",
      "type": "object"
    },
